# Non-secret defaults only. Never commit real provider keys, bot tokens or wallet secrets.

OPENCLAW_GATEWAY_PORT=18789
CLAWROUTER_PORT=8402
OLLAMA_HOST=http://127.0.0.1:11434

# Optional install behavior for Linux bootstrap.
INSTALL_SERVICES=0
INSTALL_BLOCKRUN_CLAWROUTER=0
INSTALL_GOOSE=1
INSTALL_OLLAMA=1
PULL_GOOSE_MODEL=1
LINK_GOOSE_CONTROLLERS=1

# Local Goose worker. The workspace must exist beneath this root at runtime.
GOOSE_PROVIDER=ollama
GOOSE_MODEL=qwen3:8b
GOOSE_MAX_TURNS=50
XF_GOOSE_WORKSPACE_ROOT=/srv/xfreedom-agent-workspace
# One directory name (not a path) created directly below the workspace root.
XF_GOOSE_STATE_DIR=.goose-worker-state
XF_GOOSE_TIMEOUT_SECONDS=900
XF_GOOSE_MAX_OUTPUT_BYTES=1048576
XF_GOOSE_MAX_TASK_CHARS=20000
# Optional hard boundary for the Developer extension. Goose must also be installed in the container.
# XF_GOOSE_CONTAINER=xfreedom-goose-sandbox

# Suggested routing profile labels. Actual availability depends on the provider/router you configure.
XSTACK_ROUTING_PROFILE=auto
HERMES_PROFILE=default

# Secrets belong in each runtime's supported secret/config store, not here:
# CLAWROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
